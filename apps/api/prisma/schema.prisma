// CA Practice OS — Prisma schema
// Every organization-owned business table carries organizationId with an FK + index.
// Tenant scope is always derived server-side from the authenticated session — never trust
// an organizationId supplied by the client. See apps/api/src/common/guards/tenant.guard.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organizations & Users
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  timezone  String             @default("Asia/Kolkata")
  currency  String             @default("INR")
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  users             User[]
  clients           Client[]
  taskTemplates     TaskTemplate[]
  tasks             Task[]
  complianceEvents  ComplianceEvent[]
  reminders         Reminder[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  goals             Goal[]
  calendarEvents    CalendarEvent[]
  aiConversations   AiConversation[]
  auditLogs         AuditLog[]
  refreshSessions   RefreshSession[]
  documents         Document[]
  documentVersions  DocumentVersion[]
  documentRequests  DocumentRequest[]
  notices              Notice[]
  udinRecords          UDINRecord[]
  gstProfiles          GSTProfile[]
  gstReturns           GSTReturn[]
  tdsProfiles          TDSProfile[]
  tdsReturns           TDSReturn[]
  tdsChallans          TDSChallan[]
  tdsCertificates      TDSCertificate[]
  automationRules      AutomationRule[]
  automationExecutions AutomationExecution[]

  @@map("organizations")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id              String     @id @default(cuid())
  organizationId  String
  roleId          String
  email           String     @unique
  passwordHash    String
  fullName        String
  phone           String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  assignedClients        Client[]              @relation("ClientAssignedUser")
  createdClients         Client[]              @relation("ClientCreatedBy")
  assignedTasks           Task[]                @relation("TaskAssignedUser")
  createdTasks             Task[]                @relation("TaskCreatedBy")
  taskComments             TaskComment[]
  taskAssignmentEvents      TaskAssignment[]      @relation("TaskAssignmentUser")
  taskAssignmentsMadeBy      TaskAssignment[]      @relation("TaskAssignmentActor")
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  goals                     Goal[]
  createdCalendarEvents     CalendarEvent[]
  aiConversations           AiConversation[]
  auditLogs                 AuditLog[]
  refreshSessions           RefreshSession[]
  passwordResetTokens       PasswordResetToken[]
  uploadedDocuments         Document[]                @relation("DocumentUploadedBy")
  uploadedDocumentVersions  DocumentVersion[]          @relation("DocumentVersionUploadedBy")
  createdDocumentRequests   DocumentRequest[]          @relation("DocumentRequestCreatedBy")
  assignedNotices           Notice[]                  @relation("NoticeAssignedUser")
  createdNotices            Notice[]                  @relation("NoticeCreatedBy")
  noticeComments            NoticeComment[]
  assignedUdinRecords       UDINRecord[]               @relation("UdinAssignedUser")
  createdUdinRecords        UDINRecord[]               @relation("UdinCreatedBy")
  assignedGstReturns        GSTReturn[]                @relation("GstReturnAssignedUser")
  createdGstReturns         GSTReturn[]                @relation("GstReturnCreatedBy")
  assignedTdsReturns        TDSReturn[]                @relation("TdsReturnAssignedUser")
  createdTdsReturns         TDSReturn[]                @relation("TdsReturnCreatedBy")
  createdTdsChallans        TDSChallan[]               @relation("TdsChallanCreatedBy")
  createdTdsCertificates    TDSCertificate[]           @relation("TdsCertificateCreatedBy")
  createdAutomationRules    AutomationRule[]

  @@index([organizationId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // SUPER_ADMIN | FIRM_ADMIN | MANAGER | ACCOUNTANT | STAFF | CLIENT
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "clients.view", "tasks.assign"
  category    String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshSession {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  tokenHash      String    @unique
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

enum BusinessType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  HUF
  INDIVIDUAL
  TRUST
  OTHER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  clientCode     String
  displayName    String
  legalName      String?
  businessType   BusinessType @default(OTHER)
  pan            String?
  gstin          String?
  tan            String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  pincode        String?
  status         ClientStatus @default(ACTIVE)
  assignedUserId String?
  createdByUserId String
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("ClientAssignedUser", fields: [assignedUserId], references: [id])
  createdBy    User         @relation("ClientCreatedBy", fields: [createdByUserId], references: [id])

  contacts         ClientContact[]
  services         ClientService[]
  tasks            Task[]
  complianceEvents ComplianceEvent[]
  calendarEvents   CalendarEvent[]
  documents        Document[]
  documentRequests DocumentRequest[]
  notices          Notice[]
  udinRecords      UDINRecord[]
  gstProfiles      GSTProfile[]
  gstReturns       GSTReturn[]
  tdsProfiles      TDSProfile[]
  tdsReturns       TDSReturn[]
  tdsChallans      TDSChallan[]
  tdsCertificates  TDSCertificate[]

  @@unique([organizationId, clientCode])
  @@unique([organizationId, pan])
  @@unique([organizationId, gstin])
  @@index([organizationId, status])
  @@map("clients")
}

model ClientContact {
  id             String   @id @default(cuid())
  clientId       String
  organizationId String
  name           String
  designation    String?
  email          String?
  phone          String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, clientId])
  @@map("client_contacts")
}

enum ServiceCategory {
  GST
  TDS
  INCOME_TAX
  AUDIT
  ROC
  PAYROLL
  OTHER
}

enum ClientServiceStatus {
  ACTIVE
  PAUSED
  ENDED
}

model ClientService {
  id             String              @id @default(cuid())
  clientId       String
  organizationId String
  category       ServiceCategory
  name           String
  startDate      DateTime            @default(now())
  endDate        DateTime?
  status         ClientServiceStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, category, status])
  @@index([clientId])
  @@map("client_services")
}

// ---------------------------------------------------------------------------
// Task templates & recurring engine
// ---------------------------------------------------------------------------

enum TaskFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  ONE_TIME
}

enum TaskCategory {
  CLIENT_SPECIFIC
  COMPLIANCE
  DOCUMENT
  PAYMENT
  FOLLOW_UP
  INTERNAL
}

enum TemplateScope {
  PER_CLIENT // one task generated per applicable client
  FIRM_WIDE  // one internal task for the firm, not tied to a client
}

model TaskTemplate {
  id                    String          @id @default(cuid())
  organizationId        String
  name                  String
  description           String?
  category              TaskCategory    @default(CLIENT_SPECIFIC)
  frequency             TaskFrequency
  scope                 TemplateScope   @default(PER_CLIENT)
  applicableServiceType ServiceCategory?
  defaultPriority       TaskPriority    @default(MEDIUM)
  estimatedMinutes      Int?
  checklistItems        Json            @default("[]") // string[] of checklist titles, in order
  dueDayOfPeriod        Int?            // e.g. day-of-month for MONTHLY, day-of-year offset logic kept simple for MVP
  leadDays              Int             @default(0) // generate task N days before due date
  isActive              Boolean         @default(true)
  createdByUserId       String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([organizationId, isActive])
  @@map("task_templates")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

model Task {
  id                 String        @id @default(cuid())
  organizationId     String
  clientId           String?
  templateId         String?
  title              String
  description        String?
  category           TaskCategory  @default(CLIENT_SPECIFIC)
  frequency          TaskFrequency @default(ONE_TIME)
  priority           TaskPriority  @default(MEDIUM)
  status             TaskStatus    @default(PENDING)
  assignedUserId     String?
  createdByUserId    String
  dueDate            DateTime?
  startDate          DateTime?
  estimatedMinutes   Int?
  actualMinutes      Int?
  recurrencePeriodKey String?      // e.g. "2026-08" / "2026-Q3" / "2026" — dedupe key for recurring generation
  reminderConfig     Json          @default("[]")
  rescheduledFromId  String?
  noticeId           String?       // many tasks can originate from one notice over its lifecycle
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  completedAt        DateTime?
  deletedAt          DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template     TaskTemplate? @relation(fields: [templateId], references: [id])
  assignedUser User?         @relation("TaskAssignedUser", fields: [assignedUserId], references: [id])
  createdBy    User          @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  rescheduledFrom Task?      @relation("TaskReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Task[]     @relation("TaskReschedule")
  notice          Notice?    @relation(fields: [noticeId], references: [id])

  checklistItems   TaskChecklistItem[]
  comments         TaskComment[]
  assignmentEvents TaskAssignment[]
  complianceEvent  ComplianceEvent?
  gstReturn        GSTReturn?
  tdsReturn        TDSReturn?

  @@unique([organizationId, templateId, clientId, recurrencePeriodKey])
  @@index([organizationId, assignedUserId, status, dueDate])
  @@index([organizationId, clientId])
  @@index([organizationId, dueDate])
  @@index([organizationId, noticeId])
  @@map("tasks")
}

model TaskChecklistItem {
  id           String    @id @default(cuid())
  taskId       String
  title        String
  order        Int       @default(0)
  isDone       Boolean   @default(false)
  doneAt       DateTime?
  doneByUserId String?
  createdAt    DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklist_items")
}

model TaskComment {
  id             String   @id @default(cuid())
  taskId         String
  organizationId String
  userId         String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@map("task_comments")
}

enum TaskAssignmentRole {
  OWNER
  COLLABORATOR
}

model TaskAssignment {
  id           String             @id @default(cuid())
  taskId       String
  userId       String
  role         TaskAssignmentRole @default(OWNER)
  assignedById String
  assignedAt   DateTime           @default(now())
  unassignedAt DateTime?

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User @relation("TaskAssignmentUser", fields: [userId], references: [id])
  assignedBy User @relation("TaskAssignmentActor", fields: [assignedById], references: [id])

  @@index([taskId])
  @@index([userId])
  @@map("task_assignments")
}

// ---------------------------------------------------------------------------
// Compliance engine (rules are global/system-level so every firm shares the
// same statutory definitions; events are the per-client, per-org instances)
// ---------------------------------------------------------------------------

enum ComplianceRuleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model ComplianceRule {
  id             String               @id @default(cuid())
  name           String
  category       ServiceCategory
  frequency      TaskFrequency
  description    String?
  dueDayOfPeriod Int                  // e.g. 20 => 20th of the applicable period
  periodOffsetMonths Int              @default(0) // months to add before computing the period (e.g. GSTR-3B is for previous month)
  applicableServiceType ServiceCategory?
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  source         String?
  sourceUrl      String?
  verifiedAt     DateTime?
  status         ComplianceRuleStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  complianceEvents ComplianceEvent[]

  @@index([status, category])
  @@map("compliance_rules")
}

enum ComplianceEventStatus {
  UPCOMING
  DUE
  OVERDUE
  COMPLETED
  WAIVED
}

model ComplianceEvent {
  id               String                 @id @default(cuid())
  organizationId   String
  clientId         String
  complianceRuleId String
  taskId           String?                @unique
  periodKey        String                 // e.g. "2026-08"
  dueDate          DateTime
  status           ComplianceEventStatus  @default(UPCOMING)
  completedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  complianceRule ComplianceRule @relation(fields: [complianceRuleId], references: [id])
  task           Task?          @relation(fields: [taskId], references: [id])

  @@unique([organizationId, clientId, complianceRuleId, periodKey])
  @@index([organizationId, dueDate, status])
  @@map("compliance_events")
}

// ---------------------------------------------------------------------------
// Calendar (manual events; task due-dates & compliance events are merged in
// at the API layer rather than duplicated here)
// ---------------------------------------------------------------------------

enum CalendarEventType {
  CLIENT_MEETING
  INTERNAL_MEETING
  OTHER
}

model CalendarEvent {
  id              String            @id @default(cuid())
  organizationId  String
  clientId        String?
  title           String
  description     String?
  type            CalendarEventType @default(OTHER)
  startAt         DateTime
  endAt           DateTime
  allDay          Boolean           @default(false)
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, startAt])
  @@map("calendar_events")
}

// ---------------------------------------------------------------------------
// Reminders & Notifications
// ---------------------------------------------------------------------------

enum ReminderEntityType {
  TASK
  COMPLIANCE_EVENT
  NOTICE
  GST_RETURN
  TDS_RETURN
}

enum ReminderChannel {
  IN_APP
  EMAIL   // Phase 2: provider not wired yet
  WHATSAPP // Phase 2: provider not wired yet
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model Reminder {
  id             String             @id @default(cuid())
  organizationId String
  entityType     ReminderEntityType
  entityId       String
  userId         String
  channel        ReminderChannel    @default(IN_APP)
  offsetLabel    String             // "7_DAYS_BEFORE" | "3_DAYS_BEFORE" | "1_DAY_BEFORE" | "DUE_TODAY" | "OVERDUE" | "CUSTOM"
  scheduledAt    DateTime
  status         ReminderStatus     @default(PENDING)
  retryCount     Int                @default(0)
  sentAt         DateTime?
  failureReason  String?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, scheduledAt])
  @@map("reminders")
}

enum NotificationType {
  TASK_DUE
  TASK_OVERDUE
  COMPLIANCE_DUE
  PAYMENT_DUE
  ASSIGNMENT
  FOLLOW_UP
  AI_BRIEFING
  SYSTEM
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  body           String
  entityType     String?
  entityId       String?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id              String           @id @default(cuid())
  organizationId  String
  userId          String
  type            NotificationType
  inAppEnabled    Boolean          @default(true)
  emailEnabled    Boolean          @default(false)
  whatsappEnabled Boolean          @default(false)
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Goals (progress is computed live from tasks/compliance data, not stored)
// ---------------------------------------------------------------------------

enum GoalType {
  DAILY_PRODUCTIVITY
  WEEKLY_PRODUCTIVITY
  MONTHLY_PRODUCTIVITY
  COMPLIANCE
  CLIENT_FOLLOW_UP
}

enum GoalUnit {
  PERCENT
  COUNT
}

model Goal {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  // null = firm-wide goal
  type           GoalType
  unit           GoalUnit @default(PERCENT)
  targetValue    Decimal  @db.Decimal(10, 2)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, userId, type, periodStart])
  @@map("goals")
}

// ---------------------------------------------------------------------------
// AI Copilot (domain-restricted; tool calls only, no direct DB/SQL access)
// ---------------------------------------------------------------------------

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AiMessageSource {
  TEXT
  VOICE
}

model AiConversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AiMessage[]

  @@index([organizationId, userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String
  toolName       String?
  toolInput      Json?
  toolOutput     Json?
  source         AiMessageSource  @default(TEXT)
  createdAt      DateTime         @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// ---------------------------------------------------------------------------
// Documents (private storage; StorageProvider adapter, see
// apps/api/src/documents/storage — local disk in this environment, swappable
// for S3-compatible storage without changing this schema or the API surface)
// ---------------------------------------------------------------------------

enum DocumentCategory {
  PAN
  GST
  BANK
  ITR
  TDS
  AUDIT
  ROC
  INVOICE
  CERTIFICATE
  NOTICE
  WORKING_PAPER
  OTHER
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

model Document {
  id             String           @id @default(cuid())
  organizationId String
  clientId       String?
  category       DocumentCategory @default(OTHER)
  title          String
  description    String?
  status         DocumentStatus   @default(ACTIVE)
  uploadedByUserId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  versions      DocumentVersion[]
  requestItems  DocumentRequestItem[]
  noticeLinks   NoticeDocument[]

  @@index([organizationId, clientId, status])
  @@index([organizationId, category])
  @@map("documents")
}

model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  organizationId   String
  versionNumber    Int
  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksumSha256   String
  uploadedByUserId String
  createdAt        DateTime @default(now())

  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("DocumentVersionUploadedBy", fields: [uploadedByUserId], references: [id])

  @@unique([documentId, versionNumber])
  @@index([organizationId])
  @@map("document_versions")
}

enum DocumentRequestStatus {
  PENDING
  PARTIAL
  FULFILLED
  CANCELLED
}

enum DocumentRequestItemStatus {
  PENDING
  UPLOADED
  APPROVED
  REJECTED
}

model DocumentRequest {
  id              String                @id @default(cuid())
  organizationId  String
  clientId        String
  title           String
  description     String?
  dueDate         DateTime?
  status          DocumentRequestStatus @default(PENDING)
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("DocumentRequestCreatedBy", fields: [createdByUserId], references: [id])

  items DocumentRequestItem[]

  @@index([organizationId, clientId, status])
  @@map("document_requests")
}

model DocumentRequestItem {
  id                String                     @id @default(cuid())
  documentRequestId String
  organizationId    String
  label             String
  isRequired        Boolean                    @default(true)
  status            DocumentRequestItemStatus  @default(PENDING)
  documentId        String?
  notes             String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  documentRequest DocumentRequest @relation(fields: [documentRequestId], references: [id], onDelete: Cascade)
  document        Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([documentRequestId])
  @@index([organizationId])
  @@map("document_request_items")
}

// ---------------------------------------------------------------------------
// Notices (Notice Center — full lifecycle, section 8/33 of the product spec)
// ---------------------------------------------------------------------------

enum NoticeStatus {
  NEW
  UNDER_REVIEW
  DRAFTING
  WAITING_FOR_CLIENT
  READY_TO_SUBMIT
  SUBMITTED
  CLOSED
  OVERDUE
}

model Notice {
  id               String        @id @default(cuid())
  organizationId   String
  clientId         String
  department       ServiceCategory @default(OTHER)
  noticeType       String
  referenceNumber  String
  noticeDate       DateTime
  responseDeadline DateTime?
  assignedUserId   String?
  priority         TaskPriority  @default(MEDIUM)
  status           NoticeStatus  @default(NEW)
  description      String?
  createdByUserId  String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  closedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("NoticeAssignedUser", fields: [assignedUserId], references: [id])
  createdBy    User         @relation("NoticeCreatedBy", fields: [createdByUserId], references: [id])

  comments  NoticeComment[]
  documents NoticeDocument[]
  tasks     Task[]

  @@index([organizationId, clientId, status])
  @@index([organizationId, status, responseDeadline])
  @@map("notices")
}

model NoticeComment {
  id             String   @id @default(cuid())
  noticeId       String
  organizationId String
  userId         String
  body           String
  createdAt      DateTime @default(now())

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([noticeId])
  @@map("notice_comments")
}

/** Links an already-uploaded Document to a Notice (many-to-many via join row, mirrors DocumentRequestItem's linking style). */
model NoticeDocument {
  id             String   @id @default(cuid())
  noticeId       String
  organizationId String
  documentId     String
  createdAt      DateTime @default(now())

  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([noticeId, documentId])
  @@index([organizationId])
  @@map("notice_documents")
}

// ---------------------------------------------------------------------------
// UDIN (manual entry only — the actual UDIN is generated by the CA on the
// ICAI portal; this module never synthesizes or invents a UDIN number)
// ---------------------------------------------------------------------------

enum UDINDocumentType {
  CERTIFICATE
  AUDIT_REPORT
  GST_AUDIT
  INCOME_TAX_AUDIT
  REPORT
  OTHER
}

enum UDINStatus {
  PENDING
  GENERATED
  VERIFIED
  EXPIRED
}

model UDINRecord {
  id              String           @id @default(cuid())
  organizationId  String
  clientId        String
  documentType    UDINDocumentType @default(OTHER)
  documentDate    DateTime
  description     String?
  udinNumber      String?
  generatedDate   DateTime?
  status          UDINStatus       @default(PENDING)
  assignedUserId  String?
  notes           String?
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("UdinAssignedUser", fields: [assignedUserId], references: [id])
  createdBy    User         @relation("UdinCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([organizationId, udinNumber])
  @@index([organizationId, clientId, status])
  @@map("udin_records")
}

// ---------------------------------------------------------------------------
// GST / TDS tax workflows. Shared ComplianceWorkStatus keeps GST and TDS
// return tracking consistent; both are separate from the generic
// ComplianceRule/ComplianceEvent engine (those model statutory due-date
// generation, these model the actual per-return filing workflow + who's
// working on it).
// ---------------------------------------------------------------------------

enum ComplianceWorkStatus {
  UPCOMING
  DUE_TODAY
  SUBMITTED
  COMPLETED
  OVERDUE
  WAITING_FOR_CLIENT
  NOT_APPLICABLE
}

enum GstReturnType {
  GSTR1
  GSTR3B
  GSTR9
  GSTR9C
  CMP08
  OTHER
}

model GSTProfile {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  gstin          String
  tradeName      String?
  state          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  returns      GSTReturn[]

  @@unique([organizationId, gstin])
  @@index([organizationId, clientId])
  @@map("gst_profiles")
}

model GSTReturn {
  id              String               @id @default(cuid())
  organizationId  String
  gstProfileId    String
  clientId        String
  returnType      GstReturnType
  taxPeriod       String               // e.g. "2026-08"
  dueDate         DateTime
  status          ComplianceWorkStatus @default(UPCOMING)
  assignedUserId  String?
  taskId          String?              @unique
  notes           String?
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  completedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gstProfile   GSTProfile   @relation(fields: [gstProfileId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("GstReturnAssignedUser", fields: [assignedUserId], references: [id])
  createdBy    User         @relation("GstReturnCreatedBy", fields: [createdByUserId], references: [id])
  task         Task?        @relation(fields: [taskId], references: [id])

  @@unique([organizationId, gstProfileId, returnType, taxPeriod])
  @@index([organizationId, clientId, status])
  @@index([organizationId, dueDate, status])
  @@map("gst_returns")
}

enum TdsReturnType {
  FORM_24Q
  FORM_26Q
  FORM_27Q
  FORM_27EQ
}

enum TdsChallanStatus {
  PENDING
  PAID
}

enum TdsCertificateType {
  FORM_16
  FORM_16A
  FORM_27D
}

enum TdsCertificateStatus {
  PENDING
  ISSUED
}

model TDSProfile {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  tan            String
  deductorType   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  returns      TDSReturn[]
  challans     TDSChallan[]
  certificates TDSCertificate[]

  @@unique([organizationId, tan])
  @@index([organizationId, clientId])
  @@map("tds_profiles")
}

model TDSReturn {
  id              String               @id @default(cuid())
  organizationId  String
  tdsProfileId    String
  clientId        String
  returnType      TdsReturnType
  quarter         String               // e.g. "Q1-2026-27"
  dueDate         DateTime
  status          ComplianceWorkStatus @default(UPCOMING)
  assignedUserId  String?
  taskId          String?              @unique
  notes           String?
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  completedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tdsProfile   TDSProfile   @relation(fields: [tdsProfileId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("TdsReturnAssignedUser", fields: [assignedUserId], references: [id])
  createdBy    User         @relation("TdsReturnCreatedBy", fields: [createdByUserId], references: [id])
  task         Task?        @relation(fields: [taskId], references: [id])

  @@unique([organizationId, tdsProfileId, returnType, quarter])
  @@index([organizationId, clientId, status])
  @@index([organizationId, dueDate, status])
  @@map("tds_returns")
}

model TDSChallan {
  id              String           @id @default(cuid())
  organizationId  String
  tdsProfileId    String
  clientId        String
  challanNumber   String
  amount          Decimal          @db.Decimal(12, 2)
  paymentDate     DateTime?
  section         String?
  status          TdsChallanStatus @default(PENDING)
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tdsProfile   TDSProfile   @relation(fields: [tdsProfileId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TdsChallanCreatedBy", fields: [createdByUserId], references: [id])

  @@index([organizationId, clientId, status])
  @@map("tds_challans")
}

model TDSCertificate {
  id              String               @id @default(cuid())
  organizationId  String
  tdsProfileId    String
  clientId        String
  certificateType TdsCertificateType
  quarter         String
  status          TdsCertificateStatus @default(PENDING)
  issuedDate      DateTime?
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tdsProfile   TDSProfile   @relation(fields: [tdsProfileId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TdsCertificateCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([organizationId, tdsProfileId, certificateType, quarter])
  @@index([organizationId, clientId, status])
  @@map("tds_certificates")
}

// ---------------------------------------------------------------------------
// Automations (real trigger evaluation via the existing @nestjs/schedule cron
// infrastructure — see apps/api/src/automations. Actions are limited to what
// this system can actually do today: in-app notifications and task creation.
// Email/WhatsApp action types exist in the schema/UI for forward-compat but
// are rejected at execution time until a provider is wired — never faked.)
// ---------------------------------------------------------------------------

enum AutomationTriggerType {
  TASK_OVERDUE
  COMPLIANCE_DUE_SOON
  DOCUMENT_REQUEST_OVERDUE
}

enum AutomationExecutionStatus {
  SUCCESS
  FAILED
  SKIPPED
  WAITING
  CANCELLED
}

model AutomationRule {
  id              String                @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  triggerType     AutomationTriggerType
  triggerConfig   Json                  @default("{}")
  conditions      Json                  @default("[]")
  actions         Json                  @default("[]")
  isEnabled       Boolean               @default(true)
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  lastRunAt       DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                  @relation(fields: [createdByUserId], references: [id])
  executions   AutomationExecution[]

  @@index([organizationId, isEnabled, triggerType])
  @@map("automation_rules")
}

/** One row per (rule, triggering entity) — the unique constraint IS the idempotency/duplicate-protection mechanism: a rule can fire at most once per entity, ever. */
model AutomationExecution {
  id                String                    @id @default(cuid())
  organizationId    String
  automationRuleId  String
  triggerEntityType String
  triggerEntityId   String
  clientId          String?
  status            AutomationExecutionStatus @default(WAITING)
  actionsSummary    Json                      @default("[]")
  error             String?
  triggeredAt       DateTime                  @default(now())
  completedAt       DateTime?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automationRule AutomationRule @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)

  @@unique([automationRuleId, triggerEntityType, triggerEntityId])
  @@index([organizationId, status])
  @@map("automation_executions")
}

// ---------------------------------------------------------------------------
// Audit log (append-only; never store secrets in metadata)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}
