// CA Practice OS — Prisma schema
// Every organization-owned business table carries organizationId with an FK + index.
// Tenant scope is always derived server-side from the authenticated session — never trust
// an organizationId supplied by the client. See apps/api/src/common/guards/tenant.guard.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organizations & Users
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  timezone  String             @default("Asia/Kolkata")
  currency  String             @default("INR")
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  users             User[]
  clients           Client[]
  taskTemplates     TaskTemplate[]
  tasks             Task[]
  complianceEvents  ComplianceEvent[]
  reminders         Reminder[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  goals             Goal[]
  calendarEvents    CalendarEvent[]
  aiConversations   AiConversation[]
  auditLogs         AuditLog[]
  refreshSessions   RefreshSession[]
  documents         Document[]
  documentVersions  DocumentVersion[]
  documentRequests  DocumentRequest[]

  @@map("organizations")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id              String     @id @default(cuid())
  organizationId  String
  roleId          String
  email           String     @unique
  passwordHash    String
  fullName        String
  phone           String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  assignedClients        Client[]              @relation("ClientAssignedUser")
  createdClients         Client[]              @relation("ClientCreatedBy")
  assignedTasks           Task[]                @relation("TaskAssignedUser")
  createdTasks             Task[]                @relation("TaskCreatedBy")
  taskComments             TaskComment[]
  taskAssignmentEvents      TaskAssignment[]      @relation("TaskAssignmentUser")
  taskAssignmentsMadeBy      TaskAssignment[]      @relation("TaskAssignmentActor")
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  goals                     Goal[]
  createdCalendarEvents     CalendarEvent[]
  aiConversations           AiConversation[]
  auditLogs                 AuditLog[]
  refreshSessions           RefreshSession[]
  passwordResetTokens       PasswordResetToken[]
  uploadedDocuments         Document[]                @relation("DocumentUploadedBy")
  uploadedDocumentVersions  DocumentVersion[]          @relation("DocumentVersionUploadedBy")
  createdDocumentRequests   DocumentRequest[]          @relation("DocumentRequestCreatedBy")

  @@index([organizationId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // SUPER_ADMIN | FIRM_ADMIN | MANAGER | ACCOUNTANT | STAFF | CLIENT
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "clients.view", "tasks.assign"
  category    String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshSession {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  tokenHash      String    @unique
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

enum BusinessType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  HUF
  INDIVIDUAL
  TRUST
  OTHER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  clientCode     String
  displayName    String
  legalName      String?
  businessType   BusinessType @default(OTHER)
  pan            String?
  gstin          String?
  tan            String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  pincode        String?
  status         ClientStatus @default(ACTIVE)
  assignedUserId String?
  createdByUserId String
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("ClientAssignedUser", fields: [assignedUserId], references: [id])
  createdBy    User         @relation("ClientCreatedBy", fields: [createdByUserId], references: [id])

  contacts         ClientContact[]
  services         ClientService[]
  tasks            Task[]
  complianceEvents ComplianceEvent[]
  calendarEvents   CalendarEvent[]
  documents        Document[]
  documentRequests DocumentRequest[]

  @@unique([organizationId, clientCode])
  @@unique([organizationId, pan])
  @@unique([organizationId, gstin])
  @@index([organizationId, status])
  @@map("clients")
}

model ClientContact {
  id             String   @id @default(cuid())
  clientId       String
  organizationId String
  name           String
  designation    String?
  email          String?
  phone          String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, clientId])
  @@map("client_contacts")
}

enum ServiceCategory {
  GST
  TDS
  INCOME_TAX
  AUDIT
  ROC
  PAYROLL
  OTHER
}

enum ClientServiceStatus {
  ACTIVE
  PAUSED
  ENDED
}

model ClientService {
  id             String              @id @default(cuid())
  clientId       String
  organizationId String
  category       ServiceCategory
  name           String
  startDate      DateTime            @default(now())
  endDate        DateTime?
  status         ClientServiceStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, category, status])
  @@index([clientId])
  @@map("client_services")
}

// ---------------------------------------------------------------------------
// Task templates & recurring engine
// ---------------------------------------------------------------------------

enum TaskFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  ONE_TIME
}

enum TaskCategory {
  CLIENT_SPECIFIC
  COMPLIANCE
  DOCUMENT
  PAYMENT
  FOLLOW_UP
  INTERNAL
}

enum TemplateScope {
  PER_CLIENT // one task generated per applicable client
  FIRM_WIDE  // one internal task for the firm, not tied to a client
}

model TaskTemplate {
  id                    String          @id @default(cuid())
  organizationId        String
  name                  String
  description           String?
  category              TaskCategory    @default(CLIENT_SPECIFIC)
  frequency             TaskFrequency
  scope                 TemplateScope   @default(PER_CLIENT)
  applicableServiceType ServiceCategory?
  defaultPriority       TaskPriority    @default(MEDIUM)
  estimatedMinutes      Int?
  checklistItems        Json            @default("[]") // string[] of checklist titles, in order
  dueDayOfPeriod        Int?            // e.g. day-of-month for MONTHLY, day-of-year offset logic kept simple for MVP
  leadDays              Int             @default(0) // generate task N days before due date
  isActive              Boolean         @default(true)
  createdByUserId       String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([organizationId, isActive])
  @@map("task_templates")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

model Task {
  id                 String        @id @default(cuid())
  organizationId     String
  clientId           String?
  templateId         String?
  title              String
  description        String?
  category           TaskCategory  @default(CLIENT_SPECIFIC)
  frequency          TaskFrequency @default(ONE_TIME)
  priority           TaskPriority  @default(MEDIUM)
  status             TaskStatus    @default(PENDING)
  assignedUserId     String?
  createdByUserId    String
  dueDate            DateTime?
  startDate          DateTime?
  estimatedMinutes   Int?
  actualMinutes      Int?
  recurrencePeriodKey String?      // e.g. "2026-08" / "2026-Q3" / "2026" — dedupe key for recurring generation
  reminderConfig     Json          @default("[]")
  rescheduledFromId  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  completedAt        DateTime?
  deletedAt          DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template     TaskTemplate? @relation(fields: [templateId], references: [id])
  assignedUser User?         @relation("TaskAssignedUser", fields: [assignedUserId], references: [id])
  createdBy    User          @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  rescheduledFrom Task?      @relation("TaskReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Task[]     @relation("TaskReschedule")

  checklistItems   TaskChecklistItem[]
  comments         TaskComment[]
  assignmentEvents TaskAssignment[]
  complianceEvent  ComplianceEvent?

  @@unique([organizationId, templateId, clientId, recurrencePeriodKey])
  @@index([organizationId, assignedUserId, status, dueDate])
  @@index([organizationId, clientId])
  @@index([organizationId, dueDate])
  @@map("tasks")
}

model TaskChecklistItem {
  id           String    @id @default(cuid())
  taskId       String
  title        String
  order        Int       @default(0)
  isDone       Boolean   @default(false)
  doneAt       DateTime?
  doneByUserId String?
  createdAt    DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklist_items")
}

model TaskComment {
  id             String   @id @default(cuid())
  taskId         String
  organizationId String
  userId         String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@map("task_comments")
}

enum TaskAssignmentRole {
  OWNER
  COLLABORATOR
}

model TaskAssignment {
  id           String             @id @default(cuid())
  taskId       String
  userId       String
  role         TaskAssignmentRole @default(OWNER)
  assignedById String
  assignedAt   DateTime           @default(now())
  unassignedAt DateTime?

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User @relation("TaskAssignmentUser", fields: [userId], references: [id])
  assignedBy User @relation("TaskAssignmentActor", fields: [assignedById], references: [id])

  @@index([taskId])
  @@index([userId])
  @@map("task_assignments")
}

// ---------------------------------------------------------------------------
// Compliance engine (rules are global/system-level so every firm shares the
// same statutory definitions; events are the per-client, per-org instances)
// ---------------------------------------------------------------------------

enum ComplianceRuleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model ComplianceRule {
  id             String               @id @default(cuid())
  name           String
  category       ServiceCategory
  frequency      TaskFrequency
  description    String?
  dueDayOfPeriod Int                  // e.g. 20 => 20th of the applicable period
  periodOffsetMonths Int              @default(0) // months to add before computing the period (e.g. GSTR-3B is for previous month)
  applicableServiceType ServiceCategory?
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  source         String?
  sourceUrl      String?
  verifiedAt     DateTime?
  status         ComplianceRuleStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  complianceEvents ComplianceEvent[]

  @@index([status, category])
  @@map("compliance_rules")
}

enum ComplianceEventStatus {
  UPCOMING
  DUE
  OVERDUE
  COMPLETED
  WAIVED
}

model ComplianceEvent {
  id               String                 @id @default(cuid())
  organizationId   String
  clientId         String
  complianceRuleId String
  taskId           String?                @unique
  periodKey        String                 // e.g. "2026-08"
  dueDate          DateTime
  status           ComplianceEventStatus  @default(UPCOMING)
  completedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  complianceRule ComplianceRule @relation(fields: [complianceRuleId], references: [id])
  task           Task?          @relation(fields: [taskId], references: [id])

  @@unique([organizationId, clientId, complianceRuleId, periodKey])
  @@index([organizationId, dueDate, status])
  @@map("compliance_events")
}

// ---------------------------------------------------------------------------
// Calendar (manual events; task due-dates & compliance events are merged in
// at the API layer rather than duplicated here)
// ---------------------------------------------------------------------------

enum CalendarEventType {
  CLIENT_MEETING
  INTERNAL_MEETING
  OTHER
}

model CalendarEvent {
  id              String            @id @default(cuid())
  organizationId  String
  clientId        String?
  title           String
  description     String?
  type            CalendarEventType @default(OTHER)
  startAt         DateTime
  endAt           DateTime
  allDay          Boolean           @default(false)
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, startAt])
  @@map("calendar_events")
}

// ---------------------------------------------------------------------------
// Reminders & Notifications
// ---------------------------------------------------------------------------

enum ReminderEntityType {
  TASK
  COMPLIANCE_EVENT
}

enum ReminderChannel {
  IN_APP
  EMAIL   // Phase 2: provider not wired yet
  WHATSAPP // Phase 2: provider not wired yet
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model Reminder {
  id             String             @id @default(cuid())
  organizationId String
  entityType     ReminderEntityType
  entityId       String
  userId         String
  channel        ReminderChannel    @default(IN_APP)
  offsetLabel    String             // "7_DAYS_BEFORE" | "3_DAYS_BEFORE" | "1_DAY_BEFORE" | "DUE_TODAY" | "OVERDUE" | "CUSTOM"
  scheduledAt    DateTime
  status         ReminderStatus     @default(PENDING)
  retryCount     Int                @default(0)
  sentAt         DateTime?
  failureReason  String?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, scheduledAt])
  @@map("reminders")
}

enum NotificationType {
  TASK_DUE
  TASK_OVERDUE
  COMPLIANCE_DUE
  PAYMENT_DUE
  ASSIGNMENT
  FOLLOW_UP
  AI_BRIEFING
  SYSTEM
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  body           String
  entityType     String?
  entityId       String?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id              String           @id @default(cuid())
  organizationId  String
  userId          String
  type            NotificationType
  inAppEnabled    Boolean          @default(true)
  emailEnabled    Boolean          @default(false)
  whatsappEnabled Boolean          @default(false)
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Goals (progress is computed live from tasks/compliance data, not stored)
// ---------------------------------------------------------------------------

enum GoalType {
  DAILY_PRODUCTIVITY
  WEEKLY_PRODUCTIVITY
  MONTHLY_PRODUCTIVITY
  COMPLIANCE
  CLIENT_FOLLOW_UP
}

enum GoalUnit {
  PERCENT
  COUNT
}

model Goal {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  // null = firm-wide goal
  type           GoalType
  unit           GoalUnit @default(PERCENT)
  targetValue    Decimal  @db.Decimal(10, 2)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, userId, type, periodStart])
  @@map("goals")
}

// ---------------------------------------------------------------------------
// AI Copilot (domain-restricted; tool calls only, no direct DB/SQL access)
// ---------------------------------------------------------------------------

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model AiConversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AiMessage[]

  @@index([organizationId, userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String
  toolName       String?
  toolInput      Json?
  toolOutput     Json?
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// ---------------------------------------------------------------------------
// Documents (private storage; StorageProvider adapter, see
// apps/api/src/documents/storage — local disk in this environment, swappable
// for S3-compatible storage without changing this schema or the API surface)
// ---------------------------------------------------------------------------

enum DocumentCategory {
  PAN
  GST
  BANK
  ITR
  TDS
  AUDIT
  ROC
  INVOICE
  CERTIFICATE
  NOTICE
  WORKING_PAPER
  OTHER
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

model Document {
  id             String           @id @default(cuid())
  organizationId String
  clientId       String?
  category       DocumentCategory @default(OTHER)
  title          String
  description    String?
  status         DocumentStatus   @default(ACTIVE)
  uploadedByUserId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  versions      DocumentVersion[]
  requestItems  DocumentRequestItem[]

  @@index([organizationId, clientId, status])
  @@index([organizationId, category])
  @@map("documents")
}

model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  organizationId   String
  versionNumber    Int
  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksumSha256   String
  uploadedByUserId String
  createdAt        DateTime @default(now())

  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("DocumentVersionUploadedBy", fields: [uploadedByUserId], references: [id])

  @@unique([documentId, versionNumber])
  @@index([organizationId])
  @@map("document_versions")
}

enum DocumentRequestStatus {
  PENDING
  PARTIAL
  FULFILLED
  CANCELLED
}

enum DocumentRequestItemStatus {
  PENDING
  UPLOADED
  APPROVED
  REJECTED
}

model DocumentRequest {
  id              String                @id @default(cuid())
  organizationId  String
  clientId        String
  title           String
  description     String?
  dueDate         DateTime?
  status          DocumentRequestStatus @default(PENDING)
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("DocumentRequestCreatedBy", fields: [createdByUserId], references: [id])

  items DocumentRequestItem[]

  @@index([organizationId, clientId, status])
  @@map("document_requests")
}

model DocumentRequestItem {
  id                String                     @id @default(cuid())
  documentRequestId String
  organizationId    String
  label             String
  isRequired        Boolean                    @default(true)
  status            DocumentRequestItemStatus  @default(PENDING)
  documentId        String?
  notes             String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  documentRequest DocumentRequest @relation(fields: [documentRequestId], references: [id], onDelete: Cascade)
  document        Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([documentRequestId])
  @@index([organizationId])
  @@map("document_request_items")
}

// ---------------------------------------------------------------------------
// Audit log (append-only; never store secrets in metadata)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}
