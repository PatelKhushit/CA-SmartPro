# ==============================================================================
# CA Practice OS - Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ==============================================================================

# ---- Postgres (used by docker-compose for local dev) ----
POSTGRES_USER=ca_app
POSTGRES_PASSWORD=changeme_use_a_strong_local_password
POSTGRES_DB=ca_practice_os

# ---- Database (consumed by Prisma / apps/api) ----
DATABASE_URL="postgresql://ca_app:changeme_use_a_strong_local_password@localhost:5432/ca_practice_os?schema=public"

# ---- Redis (queues, rate limiting) ----
REDIS_URL="redis://localhost:6379"

# ---- API ----
API_PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS="http://localhost:3100"

# ---- Auth / JWT ----
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_random_64_char_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_64_char_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=replace_with_another_random_secret

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"

# ---- Email (Phase 2 - transactional email provider) ----
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# ---- WhatsApp Business API / BSP (Phase 2) ----
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Object Storage (Documents module) ----
# 'local' (default) writes to STORAGE_LOCAL_DIR on the API server's disk —
# real private storage, randomized filenames, not S3. Set to 's3' (Phase 2,
# requires implementing an S3 StorageProvider) plus the S3_* vars to swap.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_MAX_UPLOAD_MB=20
# Signed download links expire after this many seconds (default 300 = 5 min)
STORAGE_SIGNED_URL_TTL_SECONDS=300
# HMAC secret for signed download URLs. Falls back to COOKIE_SECRET if unset
# locally; set a distinct strong secret in staging/production.
STORAGE_SIGNING_SECRET=
# ---- S3-compatible storage (Phase 2 - not wired yet) ----
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=

# ---- AI Copilot ----
# If left empty, the AI Copilot API returns a clear "AI not configured" error
# instead of a fake response. Never commit a real key.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-flash-latest

# ---- Payment Gateway (Phase 2) ----
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
